# Local application
# The backend must remain bound to loopback.
MAILMERGE_HOST=127.0.0.1
MAILMERGE_PORT=8765
MAILMERGE_FRONTEND_ORIGIN=http://127.0.0.1:8765

# Optional explicit path to a Vite production build. Source checkouts automatically
# discover frontend/dist, so this is mainly useful for custom packaged installs.
# MAILMERGE_FRONTEND_DIR=/absolute/path/to/frontend/dist

# Optional TOML file containing SMTP and IMAP profiles. It is loaded by both
# the web process and worker whenever they start.
# MAILMERGE_PROFILE_CONFIG=/absolute/path/to/profiles.toml

# Persistent local data: SQLite database, managed attachments, and session token.
MAILMERGE_DATA_DIR=/home/your-user/.local/share/mailmerge

# Normally leave empty so the application generates and stores a random token.
# MAILMERGE_SESSION_TOKEN=

# Background worker polling interval in seconds.
MAILMERGE_WORKER_POLL_SECONDS=2

# Hosted unsubscribe service
# Public DNS name routed to the Docker/Caddy host.
DOMAIN=unsubscribe.example.com

# Generate independent values, for example with: openssl rand -base64 48
UNSUBSCRIBE_SIGNING_SECRET=replace-with-a-long-random-signing-secret
UNSUBSCRIBE_SYNC_SECRET=replace-with-a-long-random-sync-secret

# Used inside the unsubscribe container. Usually no change is necessary.
UNSUBSCRIBE_DB=/data/events.sqlite3
